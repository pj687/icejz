.ice-toast-mask {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  background: rgba(15, 27, 45, 0.22);
  animation: mask-in 0.24s ease;
}

.ice-toast-mask.out {
  animation: mask-out 0.2s ease forwards;
}

.ice-toast {
  position: relative;
  min-width: 300rpx;
  max-width: 70vw;
  padding: 44rpx 44rpx 36rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 28rpx 64rpx rgba(15, 35, 55, 0.16),
    0 8rpx 20rpx rgba(0, 168, 232, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  animation: toast-in 0.34s cubic-bezier(0.22, 1, 0.36, 1);
}

.ice-toast.out {
  animation: toast-out 0.2s ease forwards;
}

.ice-toast-aura {
  position: absolute;
  top: -72rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle, rgba(0, 168, 232, 0.22), transparent 68%);
}

.ice-toast.ok .ice-toast-aura,
.ice-toast.male .ice-toast-aura {
  background: radial-gradient(circle, rgba(0, 168, 232, 0.3), transparent 68%);
}

.ice-toast.female .ice-toast-aura {
  background: radial-gradient(circle, rgba(226, 138, 173, 0.28), transparent 68%);
}

.ice-toast.unknown .ice-toast-aura {
  background: radial-gradient(circle, rgba(138, 160, 180, 0.28), transparent 68%);
}

.ice-toast.fail .ice-toast-aura {
  background: radial-gradient(circle, rgba(225, 29, 72, 0.22), transparent 68%);
}

.ice-toast.info .ice-toast-aura {
  background: radial-gradient(circle, rgba(0, 168, 232, 0.18), transparent 68%);
}

.ice-toast-sheen {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.55) 0%, transparent 42%, transparent 100%);
}

.ice-toast-art {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 22rpx;
  box-shadow: 0 14rpx 28rpx rgba(15, 35, 55, 0.12);
  position: relative;
  z-index: 1;
}

.ice-toast-icon {
  position: relative;
  z-index: 1;
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ice-toast-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 168, 232, 0.22);
  animation: ring-pulse 1.4s ease-out infinite;
}

.ice-toast.fail .ice-toast-ring {
  border-color: rgba(225, 29, 72, 0.22);
}

.ice-toast.female .ice-toast-ring {
  border-color: rgba(226, 138, 173, 0.28);
}

.ice-toast.unknown .ice-toast-ring {
  border-color: rgba(138, 160, 180, 0.28);
}

.ice-toast-core {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow:
    0 14rpx 28rpx rgba(0, 168, 232, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.ice-toast.ok .ice-toast-core,
.ice-toast.male .ice-toast-core,
.ice-toast.info .ice-toast-core {
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
}

.ice-toast.fail .ice-toast-core {
  background: linear-gradient(145deg, #fb7185, #e11d48);
  box-shadow:
    0 14rpx 28rpx rgba(225, 29, 72, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.ice-toast.female .ice-toast-core {
  background: linear-gradient(145deg, #f0a8c2, #e28aad);
  box-shadow:
    0 14rpx 28rpx rgba(226, 138, 173, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.ice-toast.unknown .ice-toast-core {
  background: linear-gradient(145deg, #a8b8c8, #8aa0b4);
  box-shadow:
    0 14rpx 28rpx rgba(96, 119, 137, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.ico-check {
  width: 28rpx;
  height: 16rpx;
  border-left: 5rpx solid #fff;
  border-bottom: 5rpx solid #fff;
  transform: rotate(-45deg) translate(2rpx, -2rpx);
  box-sizing: border-box;
  animation: pop-ico 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

.ico-fail {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  animation: pop-ico 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

.ico-fail-a,
.ico-fail-b {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #fff;
  margin-left: -14rpx;
  margin-top: -2.5rpx;
}

.ico-fail-a {
  transform: rotate(45deg);
}

.ico-fail-b {
  transform: rotate(-45deg);
}

.ico-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  animation: pop-ico 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

.ico-info-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}

.ico-info-stem {
  width: 6rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #fff;
}

.ico-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #fff;
  animation: pop-ico 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

.ice-toast-title {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  font-weight: 750;
  letter-spacing: 0.02em;
  color: #0f1b2d;
  text-align: center;
  line-height: 1.45;
}

.ice-toast-sub {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8492a6;
  text-align: center;
  line-height: 1.45;
}

@keyframes mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes mask-out {
  to {
    opacity: 0;
  }
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes toast-out {
  to {
    opacity: 0;
    transform: translateY(-12rpx) scale(0.96);
  }
}

@keyframes ring-pulse {
  0% {
    transform: scale(0.92);
    opacity: 0.9;
  }
  70% {
    transform: scale(1.12);
    opacity: 0;
  }
  100% {
    transform: scale(1.12);
    opacity: 0;
  }
}

@keyframes pop-ico {
  from {
    opacity: 0;
    transform: scale(0.5) rotate(-45deg) translate(2rpx, -2rpx);
  }
  to {
    opacity: 1;
  }
}

.ice-toast.ok .ico-check,
.ice-toast.male .ico-check {
  animation: check-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

@keyframes check-in {
  from {
    opacity: 0;
    transform: scale(0.4) rotate(-45deg) translate(2rpx, -2rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) rotate(-45deg) translate(2rpx, -2rpx);
  }
}
