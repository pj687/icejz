<!-- 表单触发条 -->
<view class="trigger {{verified ? 'ok' : ''}}" catchtap="open">
  <view class="trigger-main">
    <text class="trigger-title">安全验证</text>
    <text class="trigger-sub">{{verified ? verifiedText : triggerHint}}</text>
  </view>
  <text class="trigger-action">{{verified ? '重新验证' : '去验证'}}</text>
</view>

<!-- 弹窗：挂到页面根，避免被登录卡片 overflow 裁切 -->
<root-portal enable="{{true}}">
  <view wx:if="{{visible}}" class="root">
    <view class="mask" catchtap="close" catchtouchmove="noop"></view>
    <view class="panel" catchtouchmove="noop">
      <view class="panel-head">
        <view class="head-main">
          <text class="kicker">ICEJZ</text>
          <text class="title">安全验证</text>
          <text class="desc">{{tip || '请完成下方验证后继续'}}</text>
        </view>
        <view class="close" catchtap="close">关闭</view>
      </view>

      <scroll-view scroll-y class="panel-body" enhanced show-scrollbar="{{false}}">
        <!-- 滑动拼图 / 滑动曲线 -->
        <view wx:if="{{mode === 'slider' || mode === 'curve'}}" class="pattern-box {{status}}">
          <text class="pattern-tip">{{tip || (mode === 'curve' ? '拖动滑块摆动绳子，使中点对齐' : '请拖动滑块完成拼图')}}</text>
          <view class="puzzle-wrap">
            <image wx:if="{{image}}" class="pattern-img" src="{{image}}" mode="widthFix" bindload="onPuzzleImgLoad" />
            <view wx:else class="pattern-loading">加载中</view>
            <view
              wx:if="{{mode === 'slider' && jigsawImage}}"
              class="puzzle-piece"
              style="left: {{pieceLeftPercent}}%; top: {{jigsawTopPercent}}%; width: {{pieceWidthPercent}}%; height: {{pieceHeightPercent}}%;"
            >
              <image class="puzzle-piece-img" src="{{jigsawImage}}" mode="scaleToFill" />
            </view>
            <canvas
              wx:if="{{mode === 'curve' && showCurveRope}}"
              type="2d"
              id="curveRope"
              class="curve-rope-canvas"
              style="{{ropeCanvasCss}}"
            />
            <view wx:if="{{status === 'ok'}}" class="result-mask ok">{{mode === 'curve' ? '绳子已对齐' : '拼图已对齐'}}</view>
            <view wx:elif="{{status === 'fail'}}" class="result-mask fail">未对齐</view>
          </view>
          <view
            class="slider-track {{checking || status === 'ok' ? 'busy' : ''}} {{dragging ? 'active' : ''}}"
            catchtouchstart="onTrackStart"
            catchtouchmove="onTrackMove"
            catchtouchend="onTrackEnd"
            catchtouchcancel="onTrackEnd"
          >
            <view class="slider-fill" style="width: {{trackPercent}}%;">
              <view class="slider-fill-shine" />
            </view>
            <view
              class="slider-thumb {{status}} {{dragging ? 'drag' : ''}}"
              style="left: {{trackPercent}}%; transform: translate(-{{trackPercent}}%, -50%);"
            >
              <view class="thumb-ring" />
              <view class="thumb-core">
                <text class="thumb-icon">{{status === 'ok' ? '✓' : status === 'fail' ? '!' : '››'}}</text>
              </view>
            </view>
            <text wx:if="{{sliderX === 0 && status === 'idle' && !dragging}}" class="slider-placeholder">
              {{mode === 'curve' ? '拖动滑块摆动绳子，使中点对齐' : '拖动滑块对齐缺口'}}
            </text>
          </view>
          <text class="status-text {{status}}">{{statusHint}}</text>
          <view wx:if="{{status === 'fail'}}" class="fail-banner">未对齐，请重试</view>
        </view>

        <!-- 旋转 / 角度验证码 -->
        <view wx:elif="{{mode === 'rotate' || mode === 'angle'}}" class="pattern-box {{status}}">
          <text class="pattern-tip">{{tip || (mode === 'angle' ? '旋转指针至正上方' : '旋转图片至正向')}}</text>
          <view class="rotate-stage">
            <image
              wx:if="{{image}}"
              class="rotate-img"
              src="{{image}}"
              mode="aspectFit"
              style="transform: rotate({{rotateDeg}}deg);"
            />
            <view wx:else class="pattern-loading">加载中</view>
            <view wx:if="{{status === 'ok'}}" class="result-mask ok">角度正确</view>
            <view wx:elif="{{status === 'fail'}}" class="result-mask fail">角度错误</view>
          </view>
          <view
            class="slider-track {{checking || status === 'ok' ? 'busy' : ''}} {{dragging ? 'active' : ''}}"
            catchtouchstart="onTrackStart"
            catchtouchmove="onTrackMove"
            catchtouchend="onTrackEnd"
            catchtouchcancel="onTrackEnd"
          >
            <view class="slider-fill" style="width: {{trackPercent}}%;">
              <view class="slider-fill-shine" />
            </view>
            <view
              class="slider-thumb {{status}} {{dragging ? 'drag' : ''}}"
              style="left: {{trackPercent}}%; transform: translate(-{{trackPercent}}%, -50%);"
            >
              <view class="thumb-ring" />
              <view class="thumb-core">
                <text class="thumb-icon">{{status === 'ok' ? '✓' : status === 'fail' ? '!' : '↻'}}</text>
              </view>
            </view>
            <text wx:if="{{sliderX === 0 && status === 'idle' && !dragging}}" class="slider-placeholder">拖动滑块旋转</text>
          </view>
          <text class="status-text {{status}}">{{statusHint}}</text>
          <view wx:if="{{status === 'fail'}}" class="fail-banner">角度不对，正在换一张…</view>
        </view>

        <!-- 文字点选 -->
        <view wx:elif="{{mode === 'word'}}" class="pattern-box {{status}}">
          <text class="pattern-tip">{{tip || '请依次点击图中文字'}}</text>
          <view class="pattern-box-inner word-stage {{checking || status === 'ok' || status === 'fail' ? 'locked' : ''}}" catchtap="onWordTap">
            <image wx:if="{{image}}" class="pattern-img" src="{{image}}" mode="widthFix" />
            <view wx:else class="pattern-loading">加载中</view>
            <view
              wx:for="{{wordMarks}}"
              wx:key="index"
              class="mark {{status === 'ok' ? 'done' : ''}} {{status === 'fail' ? 'fail' : ''}}"
              style="left: {{item.left}}%; top: {{item.top}}%;"
            >
              <text>{{status === 'fail' ? '!' : status === 'ok' ? '✓' : index + 1}}</text>
            </view>
            <view wx:if="{{status === 'ok'}}" class="result-mask ok">验证通过</view>
            <view wx:elif="{{status === 'fail'}}" class="result-mask fail">顺序或位置错误</view>
          </view>
          <text class="status-text {{status}}">{{statusHint}}</text>
          <view wx:if="{{status === 'fail'}}" class="fail-banner">点选错误，正在换一张…</view>
        </view>

        <!-- 图案点选 -->
        <view wx:elif="{{mode === 'click'}}" class="pattern-box {{status}}">
          <text class="pattern-tip">{{tip || '请点击图中指定图案'}}</text>
          <view class="pattern-box-inner clickable {{checking || status === 'ok' || status === 'fail' ? 'locked' : ''}}" catchtap="onPatternTap">
            <image wx:if="{{image}}" class="pattern-img" src="{{image}}" mode="widthFix" />
            <view wx:else class="pattern-loading">加载中</view>
            <view
              wx:if="{{patternMark}}"
              class="mark {{status === 'ok' ? 'done' : ''}} {{status === 'fail' ? 'fail' : ''}}"
              style="left: {{patternMark.left}}%; top: {{patternMark.top}}%;"
            >
              <text>{{markText}}</text>
            </view>
            <view wx:if="{{status === 'ok'}}" class="result-mask ok">验证通过</view>
            <view wx:elif="{{status === 'fail'}}" class="result-mask fail">选择错误</view>
          </view>
          <text class="status-text {{status}}">{{statusHint}}</text>
          <view wx:if="{{status === 'fail'}}" class="fail-banner">选择错误，正在换一张…</view>
        </view>

        <!-- PoW / Turnstile：小程序端不支持 -->
        <view wx:elif="{{mode === 'pow' || mode === 'turnstile'}}" class="pattern-box">
          <view class="unsupported">
            <text class="unsupported-title">当前验证码类型不可用</text>
            <text class="unsupported-desc">小程序端暂不支持 {{mode === 'pow' ? '算力校验' : 'Turnstile'}}，请到管理端「验证码配置」将该端改为：点选图案 / 滑动拼图 / 字母数字。</text>
          </view>
        </view>

        <!-- 输入型 -->
        <view wx:else class="input-panel">
          <view class="input-row">
            <view class="captcha-input-wrap">
              <input
                class="captcha-input"
                value="{{localValue}}"
                placeholder="{{tip || '请输入验证码'}}"
                placeholder-class="captcha-ph"
                maxlength="8"
                bindinput="onInput"
              />
            </view>
            <view class="captcha-thumb" catchtap="onRefresh">
              <image wx:if="{{image}}" class="thumb-img" src="{{image}}" mode="aspectFit" />
              <text wx:else class="pattern-loading">加载中</text>
            </view>
          </view>
          <text class="status-text {{status}}">{{statusHint || '看不清可点右侧图片刷新'}}</text>
          <view wx:if="{{status === 'fail'}}" class="fail-banner">验证码错误，正在换一张…</view>
        </view>
      </scroll-view>

      <view class="panel-foot">
        <view class="btn ghost {{checking ? 'disabled' : ''}}" catchtap="onRefresh">刷新</view>
        <view
          class="btn primary {{(mode === 'pow' || mode === 'turnstile') ? 'disabled' : (canConfirm && !checking ? '' : 'disabled')}}"
          catchtap="confirm"
        >
          {{footBtnText}}
        </view>
      </view>
    </view>
  </view>
</root-portal>
