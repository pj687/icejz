.trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}
.trigger.ok {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.28);
}
.trigger-main {
  min-width: 0;
  flex: 1;
}
.trigger-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f1724;
}
.trigger-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
.trigger.ok .trigger-sub {
  color: #059669;
}
.trigger-action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #0090c8;
}

.root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 4200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 36, 0.55);
}
.panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}
.panel-head {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 28rpx 16rpx;
}
.head-main {
  flex: 1;
  min-width: 0;
}
.kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #00a8e8;
}
.title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 760;
  color: #0f1724;
}
.desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
.close {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 650;
}
.panel-body {
  flex: 1;
  max-height: 52vh;
  padding: 8rpx 28rpx 20rpx;
  box-sizing: border-box;
}
.panel-foot {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid #eef2f6;
}
.btn {
  min-height: 88rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 740;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}
.btn.ghost {
  flex: 0.7;
  background: #f1f5f9;
  color: #475569;
}
.btn.primary {
  flex: 1.3;
  color: #fff;
  background: linear-gradient(135deg, #00a8e8, #3ec6ff);
  box-shadow: 0 10rpx 22rpx rgba(0, 168, 232, 0.26);
}
.btn.disabled {
  opacity: 0.42;
  box-shadow: none;
  pointer-events: none;
}

.pattern-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.pattern-tip {
  color: #0c6f9c;
  font-size: 24rpx;
  font-weight: 600;
}
.pattern-ok {
  color: #16a34a;
  font-size: 22rpx;
}
.pattern-hint {
  color: #94a3b8;
  font-size: 22rpx;
}
.pattern-box-inner,
.puzzle-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eef5fa;
}
.pattern-box-inner.clickable {
  min-height: 160rpx;
}
.pattern-img {
  width: 100%;
  display: block;
}
.pattern-loading {
  padding: 40rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}
.puzzle-piece {
  position: absolute;
  z-index: 2;
  height: auto !important;
  display: block;
  pointer-events: none;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.28));
}
.slider-track {
  position: relative;
  height: 72rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  overflow: hidden;
}
.slider-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(0, 168, 232, 0.25), rgba(62, 198, 255, 0.45));
  border-radius: 999rpx;
  pointer-events: none;
}
.slider-thumb {
  position: absolute;
  top: 50%;
  width: 64rpx;
  height: 64rpx;
  margin-left: -32rpx;
  margin-top: -32rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #00a8e8;
  box-shadow: 0 4rpx 12rpx rgba(0, 144, 200, 0.28);
  box-sizing: border-box;
  pointer-events: none;
}
.slider-placeholder {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
  pointer-events: none;
  padding-left: 24rpx;
}

.input-row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}
.captcha-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  box-sizing: border-box;
}
.captcha-thumb {
  width: 220rpx;
  height: 88rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eef5fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.thumb-img {
  width: 100%;
  height: 100%;
}
