/* ICEJZ brand tokens · Studio light */
page {
  --icejz-primary: #00a8e8;
  --icejz-primary-deep: #0879a8;
  --icejz-accent: #3ec6ff;
  --icejz-dark: #0f1b2d;
  --icejz-bg: #f3f6fa;
  --icejz-text: #0f1b2d;
  --icejz-mute: #8492a6;
  --icejz-radius: 28rpx;
  --icejz-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.05);
  background-color: var(--icejz-bg);
  color: var(--icejz-text);
}

.t-input {
  --td-input-placeholder-text-color: #9ca3af;
  --td-input-text-color: #1f2937;
}

.t-tab-bar {
  --td-tab-bar-color: #9ca3af;
  --td-tab-bar-active-color: #00a8e8;
}

.t-cascader {
  --td-cascader-active-color: #00a8e8;
}

.t-switch {
  --td-switch-checked-color: #00a8e8;
}

.t-button {
  --td-button-font-weight: 500;
  --td-button-medium-font-size: 32rpx;
  --td-button-default-color: #fff;
  --td-button-default-bg-color: #00a8e8;
  --td-button-default-border-color: #00a8e8;
  --td-button-default-disabled-color: #fff;
  --td-button-default-disabled-bg: #cccccc;
  --td-button-default-disabled-border-color: #cccccc;
  --td-button-default-active-bg-color: #0090c8;
  --td-button-default-active-border-color: #0090c8;
}

.t-textarea {
  --td-textarea-placeholder-color: #9ca3af;
}

.t-checkbox {
  --td-checkbox-icon-checked-color: #00a8e8;
}

.dialog__button-confirm {
  color: #00a8e8 !important;
}

.dialog__button-cancel {
  color: #aeb3b7 !important;
}

.icejz-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.12), transparent 40%),
    #f3f6fa;
}

.icejz-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--icejz-radius);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: var(--icejz-shadow);
}

.icejz-hero {
  background:
    linear-gradient(165deg, rgba(255, 255, 255, 0.98), rgba(241, 248, 252, 0.94)),
    #fff;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 16rpx 40rpx rgba(15, 35, 55, 0.05);
}
