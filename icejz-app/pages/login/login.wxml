<view class="login-page">

  <view class="brand">

    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />

    <view class="login-title">ICEJZ</view>

    <view class="login-sub">低代码开发平台</view>

  </view>

  <form bindsubmit="onLogin">

    <view class="login">

      <t-input name="username" value="admin" placeholder="账号">

        <view slot="label" class="require"> 账号 </view>

      </t-input>

      <t-input type="password" name="password" value="admin" placeholder="密码">

        <view slot="label" class="require"> 密码 </view>

      </t-input>

      <t-input wx:if="{{captchaVisible}}" name="captcha" placeholder="输入验证码">

        <view slot="label" class="require"> 验证码 </view>

        <view slot="suffix">

          <image class="image" src="{{captchaBase64}}" mode="heightFix" bind:tap="onCaptcha" />

        </view>

      </t-input>

      <view class="login-btn">

        <t-button block type="submit">登录</t-button>

      </view>

    </view>

  </form>

</view>

