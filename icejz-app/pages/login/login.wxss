.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 10%, rgba(0, 168, 232, 0.34), transparent 30%),
    radial-gradient(circle at 88% 22%, rgba(62, 198, 255, 0.18), transparent 28%),
    linear-gradient(180deg, #101826 0%, #162433 42%, #f4f7fb 42%);
  padding: 96rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-logo {
  width: 148rpx;
  height: 148rpx;
  border-radius: 32rpx;
  margin-bottom: 22rpx;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.22);
}

.login-title {
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
}

.login-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 28rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}

.login-tag {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.login {
  margin: 0;
  padding: 36rpx 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 36, 0.14);
}

.captcha-block {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.login-btn {
  margin-top: 28rpx;
}
