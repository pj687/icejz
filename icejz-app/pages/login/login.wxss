.login-page {
  --ink: #0f1b2d;
  --mute: #8492a6;
  --cyan: #00a8e8;
  --canvas: #f3f6fa;
  position: relative;
  min-height: 100vh;
  padding: 0 36rpx 48rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  overflow-y: auto;
  background: var(--canvas);
}

.bg-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.bg-base {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 168, 232, 0.14), transparent 58%),
    linear-gradient(180deg, #eef6fb 0%, #f3f6fa 48%, #f8fafc 100%);
}

.blob {
  position: absolute;
  border-radius: 50%;
}

.b1 {
  width: 460rpx;
  height: 460rpx;
  top: -140rpx;
  right: -120rpx;
  background: radial-gradient(circle, rgba(0, 168, 232, 0.16), transparent 68%);
}

.b2 {
  width: 360rpx;
  height: 360rpx;
  top: 42%;
  left: -160rpx;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.14), transparent 70%);
}

.b3 {
  width: 240rpx;
  height: 240rpx;
  bottom: 8%;
  right: -40rpx;
  background: radial-gradient(circle, rgba(8, 121, 168, 0.1), transparent 72%);
}

.bg-mesh {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  background-image:
    linear-gradient(rgba(0, 168, 232, 0.07) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 168, 232, 0.07) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
  mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent 78%);
}

.bg-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 36%, transparent 42%, rgba(243, 246, 250, 0.55) 100%);
}

.lang-bar,
.brand-block,
.card,
.footnote {
  position: relative;
  z-index: 2;
}

.lang-bar {
  display: flex;
  justify-content: flex-start;
  padding: 12rpx 0 0;
}

.lang-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 8rpx 18rpx rgba(15, 35, 55, 0.05);
}

.lang-code {
  font-size: 22rpx;
  font-weight: 800;
  color: #00a8e8;
}

.lang-sep {
  font-size: 20rpx;
  color: #c5ced6;
}

.lang-next {
  font-size: 22rpx;
  font-weight: 650;
  color: #8492a6;
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 20rpx;
  text-align: center;
}

.logo-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 20rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #041018;
  box-shadow: 0 14rpx 28rpx rgba(15, 35, 55, 0.14);
  animation: logo-float 4.5s ease-in-out infinite;
}

.brand-logo {
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
  display: block;
}

.logo-pulse {
  position: absolute;
  inset: -8rpx;
  border-radius: 42rpx;
  border: 2rpx solid rgba(0, 168, 232, 0.24);
  animation: ring-glow 3.2s ease-in-out infinite;
  pointer-events: none;
}

.logo-shine {
  position: absolute;
  inset: 0;
  border-radius: 36rpx;
  overflow: hidden;
  pointer-events: none;
}

.logo-shine::before {
  content: '';
  position: absolute;
  top: -40%;
  left: -60%;
  width: 48%;
  height: 180%;
  background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  transform: rotate(18deg);
  animation: logo-shine 4.8s ease-in-out infinite;
}

.hero-title {
  line-height: 1;
}

.hero-ice,
.hero-jz {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-ice {
  color: var(--ink);
}

.hero-jz {
  color: var(--cyan);
}

.slogan {
  display: block;
  margin-top: 14rpx;
  color: var(--mute);
  font-size: 24rpx;
}

.brand-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 24rpx rgba(15, 35, 55, 0.05);
}

.eyebrow-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 0 6rpx rgba(0, 168, 232, 0.14);
  animation: pulse-dot 2.2s ease-in-out infinite;
}

.eyebrow-text {
  font-size: 20rpx;
  font-weight: 650;
  color: var(--mute);
}

.card {
  position: relative;
  margin-top: 12rpx;
  padding: 40rpx 30rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 24rpx 56rpx rgba(15, 35, 55, 0.08),
    0 2rpx 0 rgba(255, 255, 255, 0.95) inset;
  overflow: visible;
}

.card-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(36rpx);
}

.card-glow.g-a {
  width: 300rpx;
  height: 300rpx;
  right: -100rpx;
  top: -140rpx;
  background: rgba(0, 168, 232, 0.16);
}

.card-glow.g-b {
  width: 220rpx;
  height: 220rpx;
  left: -80rpx;
  bottom: -90rpx;
  background: rgba(56, 189, 248, 0.12);
}

.card-sheen {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.55) 0%, transparent 38%, transparent 100%);
}

.card-head {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.card-kicker {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 168, 232, 0.08);
}

.kicker-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 0 5rpx rgba(16, 185, 129, 0.14);
  animation: pulse-dot 2s ease-in-out infinite;
}

.kicker-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #0284c7;
}

.card-sub {
  display: block;
  color: var(--mute);
  font-size: 24rpx;
  line-height: 1.45;
}

.tabs {
  position: relative;
  z-index: 1;
  display: flex;
  margin-bottom: 30rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(243, 246, 250, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  color: var(--mute);
  font-size: 26rpx;
  font-weight: 650;
  border-radius: 999rpx;
  position: relative;
  z-index: 1;
}

.tab.active {
  color: #fff;
}

.tab-indicator {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: calc(50% - 8rpx);
  border-radius: 999rpx;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow: 0 12rpx 24rpx rgba(0, 168, 232, 0.28);
  transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  z-index: 0;
  pointer-events: none;
}

.tab-indicator.mobile {
  transform: translateX(100%);
}

.form-body,
.complete-body {
  position: relative;
  z-index: 1;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #8492a6;
}

.field-shell {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #f5f8fb;
  border: 1rpx solid #e8eef5;
  box-sizing: border-box;
}

.field-shell.flex {
  flex: 1;
  min-width: 0;
}

.field-shell.error {
  border-color: rgba(225, 29, 72, 0.4);
  background: #fff5f7;
}

.field-shell.readonly {
  background: #eef2f6;
}

.field-ico {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.field-ico-img {
  width: 28rpx;
  height: 28rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.field-tip {
  display: block;
  margin-top: 10rpx;
  padding-left: 12rpx;
  color: var(--mute);
  font-size: 20rpx;
}

.field-tip.err {
  color: #e11d48;
}

.security-shell {
  padding: 8rpx 4rpx;
}

.captcha-row {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
}

.code-btn {
  min-width: 196rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(0, 168, 232, 0.1);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.code-btn-text {
  color: #0284c7;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.code-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.submit-btn {
  margin: 18rpx auto 0;
  width: 78%;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 720;
  color: #fff;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow: 0 16rpx 32rpx rgba(0, 168, 232, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.ghost-btn {
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  background: #f7fafc;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.ghost-btn.block {
  width: 100%;
  margin-bottom: 16rpx;
}

.ghost-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  animation: spin 1s linear infinite;
}

.complete-title {
  display: block;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 800;
}

.complete-desc {
  display: block;
  margin: 10rpx 0 24rpx;
  color: var(--mute);
  font-size: 24rpx;
  line-height: 1.6;
}

.role-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.gender-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.role-card {
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  background: #f7fafc;
  border: 2rpx solid transparent;
  text-align: center;
  box-sizing: border-box;
}

.role-card.active {
  background: rgba(0, 168, 232, 0.08);
  border-color: rgba(0, 168, 232, 0.42);
  box-shadow: 0 10rpx 22rpx rgba(0, 168, 232, 0.1);
}

.role-card.compact {
  padding: 20rpx 8rpx;
}

.role-name {
  display: block;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.role-tip {
  display: block;
  margin-top: 8rpx;
  color: var(--mute);
  font-size: 20rpx;
  line-height: 1.4;
}

.card-secure {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(238, 242, 247, 0.95);
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.secure-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f3f6fa;
  color: #8492a6;
  font-size: 20rpx;
  font-weight: 600;
}

.footnote {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa8b6;
  letter-spacing: 0.04em;
  line-height: 1.5;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes logo-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes ring-glow {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.96);
  }
  50% {
    opacity: 1;
    transform: scale(1.04);
  }
}

@keyframes logo-shine {
  0%,
  55% {
    transform: translateX(0) rotate(18deg);
    opacity: 0;
  }
  70% {
    opacity: 0.85;
  }
  100% {
    transform: translateX(280%) rotate(18deg);
    opacity: 0;
  }
}

@keyframes pulse-dot {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}
