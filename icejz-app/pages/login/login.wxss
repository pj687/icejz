.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 12%, rgba(0, 168, 232, 0.28), transparent 28%),
    linear-gradient(180deg, #121a28 0%, #1a2332 45%, #f4f7fb 45%);
  padding: 80rpx 32rpx 40rpx;
  box-sizing: border-box;
}


.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
}

.login-title {
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.login-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  letter-spacing: 6rpx;
}

.login {
  margin: 0;
  padding: 32rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(20, 24, 32, 0.08);
}

.login-btn {
  margin-top: 40rpx;
}

.image {
  width: 200px;
  height: 36px;
  display: block;
  margin-top: -6px;
  margin-bottom: -6px;
}
