<view class="home">
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="brand">{{brand.name}}</view>
        <view class="slogan">{{brand.slogan}}</view>
        <view class="hello">{{greeting}}，{{displayName}}</view>
      </view>
      <image class="logo" src="/images/logo.png" mode="aspectFit" />
    </view>
    <view class="hero-line">{{brand.homeLine}}</view>
  </view>

  <view class="action-row">
    <view class="action primary" data-path="/pages/workbench/workbench" data-tab="true" bindtap="onQuickTap">
      <view class="action-title">进入工作台</view>
      <view class="action-desc">用户 / 机构 / 角色</view>
    </view>
    <view class="action" data-path="/pages/message/inbox" bindtap="onQuickTap">
      <view class="action-title">我的消息</view>
      <view class="action-desc">{{unreadCount > 0 ? unreadCount + ' 条未读' : '暂无未读'}}</view>
    </view>
  </view>

  <view class="block">
    <view class="block-head">
      <view class="block-title">今日协同</view>
      <view class="block-link" data-path="/pages/usercenter/usercenter" data-tab="true" bindtap="onQuickTap">个人中心</view>
    </view>
    <view class="metric-grid">
      <view class="metric" data-path="/pages/sys/user/index" bindtap="onQuickTap">
        <view class="metric-label">用户</view>
        <view class="metric-value">查阅</view>
      </view>
      <view class="metric" data-path="/pages/sys/org/index" bindtap="onQuickTap">
        <view class="metric-label">机构</view>
        <view class="metric-value">架构</view>
      </view>
      <view class="metric" data-path="/pages/sys/role/index" bindtap="onQuickTap">
        <view class="metric-label">角色</view>
        <view class="metric-value">权限</view>
      </view>
      <view class="metric" data-path="/pages/message/inbox" bindtap="onQuickTap">
        <view class="metric-label">消息</view>
        <view class="metric-value">{{unreadCount}}</view>
      </view>
    </view>
  </view>

  <view class="block">
    <view class="block-head">
      <view class="block-title">平台能力</view>
    </view>
    <view class="cap-list">
      <view class="cap" wx:for="{{features}}" wx:key="title">
        <view class="cap-index">0{{index + 1}}</view>
        <view class="cap-body">
          <view class="cap-title">{{item.title}}</view>
          <view class="cap-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
