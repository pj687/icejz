.home {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f3f6fa;
  overflow: hidden;
}

.ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.ambient.a1 {
  width: 460rpx;
  height: 460rpx;
  top: -160rpx;
  right: -120rpx;
  background: radial-gradient(circle, rgba(0, 168, 232, 0.18), transparent 70%);
}

.ambient.a2 {
  width: 360rpx;
  height: 360rpx;
  top: 280rpx;
  left: -140rpx;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.14), transparent 70%);
}

.top,
.body {
  position: relative;
  z-index: 1;
}

.top {
  padding: 0 28rpx 8rpx;
}

.nav {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  flex: 1;
}

.nav-brand-copy {
  min-width: 0;
  flex: 1;
}

.nav-capsule-pad {
  flex-shrink: 0;
  height: 1px;
}

.logo-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 22rpx rgba(15, 35, 55, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.logo {
  width: 42rpx;
  height: 42rpx;
}

.logo-text {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #0f1b2d;
}

.logo-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #8492a6;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-msg {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 22rpx rgba(15, 35, 55, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-msg-ico {
  width: 32rpx;
  height: 32rpx;
}

.nav-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #fb7185;
  color: #fff;
  font-size: 16rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 700;
  box-sizing: border-box;
}

.hero {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.06);
}

.hello {
  display: block;
  font-size: 24rpx;
  color: #8492a6;
  font-weight: 600;
}

.wordmark {
  margin-top: 10rpx;
  line-height: 1;
}

.ice,
.jz {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.ice {
  color: #0f1b2d;
}

.jz {
  color: #00a8e8;
}

.lead {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8492a6;
  line-height: 1.5;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.action {
  flex: 1;
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: #f3f6fa;
}

.action.main {
  flex: 1.35;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow: 0 12rpx 24rpx rgba(0, 168, 232, 0.24);
}

.action-t {
  display: block;
  font-size: 28rpx;
  font-weight: 750;
  color: #0f1b2d;
}

.action.main .action-t {
  color: #fff;
}

.action-d {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8492a6;
}

.action.main .action-d {
  color: rgba(255, 255, 255, 0.82);
}

.body {
  padding: 12rpx 24rpx 28rpx;
}

.kpi-row {
  display: flex;
  gap: 12rpx;
}

.kpi-card {
  flex: 1;
  padding: 22rpx 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(15, 35, 55, 0.05);
  text-align: center;
}

.kpi-lab {
  display: block;
  font-size: 20rpx;
  color: #8492a6;
  font-weight: 600;
}

.kpi-num {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f1b2d;
  line-height: 1;
}

.card {
  margin-top: 16rpx;
  padding: 26rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.05);
}

.card-head {
  margin-bottom: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.sec-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #0f1b2d;
}

.sec-sub {
  font-size: 22rpx;
  color: #8492a6;
}

.entry-grid {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.entry-orb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #eaf7fd, #dff2fb);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 10rpx 22rpx rgba(0, 140, 200, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
}

.entry-img {
  width: 40rpx;
  height: 40rpx;
}

.entry-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #0f1b2d;
}

.entry-hint {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #8492a6;
}

.empty-tip {
  text-align: center;
  padding: 48rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-orb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  background: radial-gradient(circle at 35% 30%, #e8f7fd, #bae6fd 60%, #7dd3fc);
  box-shadow: 0 12rpx 24rpx rgba(0, 168, 232, 0.16);
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 750;
  color: #0f1b2d;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8492a6;
  line-height: 1.5;
}

.feat-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.feat {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: #f7fafc;
}

.feat-i {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: rgba(0, 168, 232, 0.12);
  color: #00a8e8;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feat-body {
  min-width: 0;
}

.feat-t {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f1b2d;
}

.feat-d {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8492a6;
  line-height: 1.5;
}

.foot {
  display: block;
  margin: 32rpx 0 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #9aa8b6;
  letter-spacing: 0.06em;
}

.xiaobing-fab {
  position: fixed;
  right: 20rpx;
  bottom: calc(188rpx + env(safe-area-inset-bottom));
  z-index: 80;
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fab-float 3.4s ease-in-out infinite;
}

.fab-stage {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-halo {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 168, 232, 0.22), transparent 68%);
  animation: fab-halo 2.6s ease-in-out infinite;
}

.fab-orbit {
  position: absolute;
  border-radius: 50%;
  box-sizing: border-box;
  pointer-events: none;
}

.fab-orbit.o1 {
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid rgba(0, 168, 232, 0.12);
  border-top-color: rgba(0, 168, 232, 0.55);
  border-right-color: rgba(43, 184, 239, 0.2);
  animation: fab-spin 8s linear infinite;
}

.fab-orbit.o2 {
  width: 98rpx;
  height: 98rpx;
  border: 1rpx dashed rgba(0, 168, 232, 0.22);
  animation: fab-spin-rev 14s linear infinite;
}

.fab-spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #2bb8ef;
  box-shadow: 0 0 10rpx rgba(0, 168, 232, 0.45);
  animation: fab-pulse 1.8s ease-in-out infinite;
}

.fab-spark.s1 {
  top: 8rpx;
  right: 18rpx;
}

.fab-spark.s2 {
  bottom: 14rpx;
  left: 14rpx;
  width: 6rpx;
  height: 6rpx;
  background: #7dd3fc;
  animation-delay: 0.45s;
}

.fab-orb {
  position: relative;
  z-index: 1;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.98), rgba(232, 247, 253, 0.94) 48%, rgba(214, 240, 251, 0.92));
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 16rpx 32rpx rgba(0, 168, 232, 0.22),
    0 6rpx 14rpx rgba(15, 35, 55, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.fab-sheen {
  position: absolute;
  inset: 0;
  background: linear-gradient(125deg, rgba(255, 255, 255, 0.75), transparent 42%);
  pointer-events: none;
}

.fab-img {
  position: relative;
  z-index: 1;
  width: 78rpx;
  height: 78rpx;
  animation: fab-bob 2.8s ease-in-out infinite;
}

.fab-live {
  position: absolute;
  right: 4rpx;
  bottom: 6rpx;
  z-index: 2;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 3rpx 8rpx rgba(15, 35, 55, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-live-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3rpx rgba(34, 197, 94, 0.18);
  animation: fab-live 1.6s ease-in-out infinite;
}

.fab-tag {
  margin-top: -2rpx;
  z-index: 2;
  min-height: 30rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 8rpx 16rpx rgba(15, 35, 55, 0.08),
    0 0 0 1rpx rgba(0, 168, 232, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.fab-tag-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #00a8e8;
  box-shadow: 0 0 0 3rpx rgba(0, 168, 232, 0.14);
}

.fab-tag-lab {
  font-size: 16rpx;
  font-weight: 750;
  color: #0284c7;
  line-height: 1;
  letter-spacing: 0.04em;
}

@keyframes fab-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

@keyframes fab-halo {
  0%,
  100% {
    transform: scale(0.92);
    opacity: 0.55;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

@keyframes fab-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes fab-spin-rev {
  to {
    transform: rotate(-360deg);
  }
}

@keyframes fab-pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

@keyframes fab-bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4rpx);
  }
}

@keyframes fab-live {
  0%,
  100% {
    transform: scale(0.92);
    opacity: 0.75;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}
