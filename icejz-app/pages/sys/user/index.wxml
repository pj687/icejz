<view class="page">
  <ice-nav-bar title="{{copy.userTitle}}" sub="{{copy.userSub}}" />

  <view class="search-bar">
    <input
      class="search-input"
      placeholder="{{copy.searchUsername}}"
      value="{{keyword}}"
      bindinput="onKeyword"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">{{copy.search}}</view>
  </view>

  <view wx:if="{{!loading && list.length}}" class="result-tip">共 {{total}} 人</view>

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-mark">···</view>
    <view class="empty-title">{{copy.loadingUser}}</view>
  </view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-mark">用</view>
    <view class="empty-title">{{copy.emptyUser}}</view>
    <view class="empty-desc">{{copy.emptyUserHint}}</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="avatar">{{item._initial}}</view>
    <view class="card-main">
      <view class="row">
        <view class="name">{{item.realName || item.username}}</view>
        <view class="status {{item._on ? 'on' : 'off'}}">{{item._on ? copy.normal : copy.disabled}}</view>
      </view>
      <view class="meta">@{{item.username}}</view>
      <view class="tags">
        <view class="tag">{{copy.mobile}} {{item.mobile || '-'}}</view>
        <view class="tag">{{copy.email}} {{item.email || '-'}}</view>
      </view>
    </view>
  </view>
</view>
