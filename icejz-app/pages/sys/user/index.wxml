<view class="page">
  <view class="hero">
    <view class="hero-kicker">系统管理</view>
    <view class="hero-title">用户管理</view>
    <view class="hero-sub">数据来自管理端同一接口，支持按账号搜索</view>
  </view>

  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索用户名"
      value="{{keyword}}"
      bindinput="onKeyword"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-mark">···</view>
    <view class="empty-title">加载用户中</view>
  </view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-mark">用</view>
    <view class="empty-title">暂无用户数据</view>
    <view class="empty-desc">请确认账号权限或更换搜索条件</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="avatar">{{item._initial}}</view>
    <view class="card-main">
      <view class="row">
        <view class="name">{{item.realName || item.username}}</view>
        <view class="status {{item.status === 1 ? 'on' : 'off'}}">{{item.status === 1 ? '正常' : '停用'}}</view>
      </view>
      <view class="meta">@{{item.username}}</view>
      <view class="tags">
        <view class="tag">手机 {{item.mobile || '-'}}</view>
        <view class="tag">邮箱 {{item.email || '-'}}</view>
      </view>
    </view>
  </view>
</view>
