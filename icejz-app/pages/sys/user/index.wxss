.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.1), transparent 36%),
    #f4f7fb;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  background:
    radial-gradient(circle at 90% 10%, rgba(62, 198, 255, 0.32), transparent 36%),
    linear-gradient(135deg, #121a28 0%, #0c6f9c 100%);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 36, 0.16);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.search-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 36, 0.03);
}

.search-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  background: #00a8e8;
  color: #fff;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(0, 168, 232, 0.28);
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: #e8f7fd;
  color: #00a8e8;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  margin-top: 18rpx;
  color: #475569;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.card {
  display: flex;
  gap: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #00a8e8, #0c6f9c);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.status {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.status.on {
  background: #dcfce7;
  color: #15803d;
}

.status.off {
  background: #fee2e2;
  color: #dc2626;
}

.meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #00a8e8;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  font-size: 20rpx;
  color: #64748b;
  background: #f4f7fb;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}
