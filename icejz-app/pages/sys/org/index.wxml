<view class="page">
  <ice-nav-bar title="{{copy.orgTitle}}" sub="{{copy.orgSub}}" />

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-mark">···</view>
    <view class="empty-title">{{copy.loadingOrg}}</view>
  </view>
  <view wx:elif="{{!flatList.length}}" class="empty">
    <view class="empty-mark">机</view>
    <view class="empty-title">{{copy.emptyOrg}}</view>
  </view>

  <view class="tree" wx:if="{{flatList.length}}">
    <view class="tree-head">
      <text class="tree-count">共 {{nodeCount}} 个节点</text>
      <view class="tree-actions">
        <text class="tree-action" bindtap="expandAll">{{copy.expandAll}}</text>
        <text class="tree-sep">|</text>
        <text class="tree-action" bindtap="collapseAll">{{copy.collapseAll}}</text>
      </view>
    </view>
    <view
      wx:for="{{visibleList}}"
      wx:key="id"
      class="node lv-{{item._level > 2 ? 2 : item._level}} {{item._level === 0 ? 'root' : ''}} {{item._hasChildren ? 'foldable' : 'leaf'}}"
      style="padding-left: {{24 + item._level * 36}}rpx;"
      data-id="{{item.id}}"
      data-has-children="{{item._hasChildren}}"
      bindtap="onToggle"
    >
      <view class="guide" wx:if="{{item._level > 0}}">
        <view class="guide-v" />
        <view class="guide-h" />
      </view>
      <view class="node-icon tone-{{item._level > 2 ? 2 : item._level}}">
        {{item._level === 0 ? '组' : '机'}}
      </view>
      <view class="node-main">
        <view class="node-name">{{item.name}}</view>
        <view class="node-meta">
          <text class="pill">L{{item._level + 1}}</text>
          <text wx:if="{{item._hasChildren}}">{{item._childCount}} 个子机构</text>
          <text wx:else>{{item.parentName || copy.topOrg}}</text>
          <text class="dot">·</text>
          <text>{{copy.sort}} {{item.sort}}</text>
        </view>
      </view>
      <view wx:if="{{item._hasChildren}}" class="caret {{item._expanded ? 'open' : ''}}">›</view>
    </view>
  </view>
</view>
