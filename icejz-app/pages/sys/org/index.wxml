<view class="page">
  <view class="hero">
    <view class="hero-kicker">系统管理</view>
    <view class="hero-title">机构管理</view>
    <view class="hero-sub">展示与管理端一致的组织架构树</view>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-mark">···</view>
    <view class="empty-title">加载机构中</view>
  </view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-mark">机</view>
    <view class="empty-title">暂无机构数据</view>
  </view>

  <view class="tree" wx:if="{{list.length}}">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="node {{item._level === 0 ? 'root' : ''}}"
      style="margin-left: {{item._level * 28}}rpx;"
    >
      <view class="node-rail" wx:if="{{item._level > 0}}"></view>
      <view class="node-icon">{{item._level === 0 ? '组' : '机'}}</view>
      <view class="node-main">
        <view class="node-name">{{item.name}}</view>
        <view class="node-meta">{{item.parentName || '顶级机构'}} · 排序 {{item.sort}}</view>
      </view>
    </view>
  </view>
</view>
