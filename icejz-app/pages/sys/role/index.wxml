<view class="page">
  <view class="hero">
    <view class="hero-kicker">系统管理</view>
    <view class="hero-title">角色管理</view>
    <view class="hero-sub">查看管理端配置的角色与编码</view>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-mark">···</view>
    <view class="empty-title">加载角色中</view>
  </view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-mark">角</view>
    <view class="empty-title">暂无角色数据</view>
    <view class="empty-desc">可能缺少角色查看权限</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="badge">角</view>
    <view class="main">
      <view class="name">{{item.name}}</view>
      <view class="code">{{item.roleCode || item.code || '未设置编码'}}</view>
      <view class="remark">{{item.remark || '暂无备注'}}</view>
    </view>
  </view>
</view>
