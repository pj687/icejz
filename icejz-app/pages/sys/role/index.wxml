<view class="page">
  <ice-nav-bar title="{{copy.roleTitle}}" sub="{{copy.roleSub}}" />

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-mark">···</view>
    <view class="empty-title">{{copy.loadingRole}}</view>
  </view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-mark">角</view>
    <view class="empty-title">{{copy.emptyRole}}</view>
    <view class="empty-desc">{{copy.emptyRoleHint}}</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="badge">角</view>
    <view class="main">
      <view class="name">{{item.name}}</view>
      <view class="code">{{item.roleCode || item.code || copy.noCode}}</view>
      <view class="remark">{{item.remark || copy.noRemark}}</view>
    </view>
  </view>
</view>
