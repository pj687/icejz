.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.1), transparent 36%),
    #f4f7fb;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  background:
    radial-gradient(circle at 90% 10%, rgba(62, 198, 255, 0.32), transparent 36%),
    linear-gradient(135deg, #121a28 0%, #0c6f9c 100%);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 36, 0.16);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: #e8f7fd;
  color: #00a8e8;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  margin-top: 18rpx;
  color: #475569;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.card {
  display: flex;
  gap: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #121a28, #0c6f9c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.code {
  margin-top: 8rpx;
  display: inline-block;
  font-size: 22rpx;
  color: #00a8e8;
  background: #e8f7fd;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.remark {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}
