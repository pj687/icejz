<view class="page">
  <view class="ambient a1" />
  <view class="ambient a2" />

  <view class="top" style="padding-top: {{statusBarPx + 12}}px;">
    <view class="idcard" data-path="/pages/usercenter/userinfo/userinfo" bindtap="onNav">
      <view class="idcard-glow g1" />
      <view class="idcard-glow g2" />

      <view class="idcard-head">
        <view class="idcard-brand">
          <text class="idcard-ice">ICE</text><text class="idcard-jz">JZ</text>
          <text class="idcard-slash">/</text>
          <text class="idcard-sub">{{copy.cardBrandSub}}</text>
        </view>
      </view>

      <view class="idcard-main">
        <view class="idcard-avatar-wrap">
          <view class="idcard-halo" />
          <view class="idcard-ring">
            <image class="idcard-avatar" src="{{avatar}}" mode="aspectFill" />
          </view>
        </view>

        <view class="idcard-copy">
          <text class="idcard-hello">{{greetText}}</text>
          <text class="idcard-name">{{displayName}}</text>
          <text class="idcard-meta">{{badgeMeta}}</text>
        </view>

        <view class="idcard-date">
          <text class="idcard-week">{{weekDay}}</text>
          <text class="idcard-day">{{todayLabel}}</text>
        </view>
      </view>

      <view class="idcard-foot">
        <view class="idcard-foot-left">
          <text wx:if="{{username}}" class="idcard-account">@{{username}}</text>
          <text class="idcard-tip">{{copy.statusLine}}</text>
        </view>
        <view class="idcard-live">
          <view class="idcard-live-dot" />
          <text class="idcard-live-t">{{copy.cardOnDuty}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="kpi-row">
      <view wx:for="{{kpiList}}" wx:key="key" class="kpi-card">
        <view class="kpi-top">
          <text class="kpi-lab">{{item.label}}</text>
          <text class="kpi-trend">{{copy.trendUp}}</text>
        </view>
        <text class="kpi-num">{{item.value}}</text>
        <view class="spark">
          <ice-echart
            canvas-id="{{item.canvasId}}"
            height="72rpx"
            option="{{item.sparkOption}}"
          />
        </view>
      </view>
    </view>

    <view class="suggest" data-path="/pages/assistant/chat" bindtap="onNav">
      <view class="suggest-ico">
        <image class="suggest-img" src="/images/mascot/xiaobing-head.png" mode="aspectFit" />
      </view>
      <view class="suggest-copy">
        <text class="suggest-title">{{copy.suggestTitle}}</text>
        <text class="suggest-body">{{copy.suggestBody}}</text>
      </view>
      <text class="suggest-go">{{copy.suggestAction}}</text>
    </view>

    <view class="card">
      <text class="sec-title">{{copy.quickNav}}</text>
      <view class="quick-grid">
        <view
          wx:for="{{quickNav}}"
          wx:key="path"
          class="quick-item"
          data-path="{{item.path}}"
          data-tab="{{item.tab}}"
          bindtap="onNav"
        >
          <view class="quick-orb">
            <image class="quick-img" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <text class="quick-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view>
          <text class="sec-title">{{copy.focusTitle}}</text>
          <text class="sec-sub">{{copy.focusSub}}</text>
        </view>
        <text class="chip">{{focusCountText}}</text>
      </view>
      <view class="project-list">
        <view wx:for="{{projects}}" wx:key="id" class="project-row tone-{{item.tone}}">
          <view class="project-main">
            <view class="project-title">
              <text class="project-name">{{item.title}}</text>
              <text class="project-days">{{item.daysLeftText}}</text>
            </view>
            <text class="project-desc">{{item.desc}}</text>
            <view class="progress">
              <view class="track">
                <view class="fill fill-{{item.tone}}" style="width: {{item.percent}}%;" />
              </view>
              <text class="pct">{{item.percent}}%</text>
            </view>
          </view>
          <view class="btn-enter" data-path="{{item.path}}" bindtap="onNav">{{copy.enter}}</view>
        </view>
      </view>
    </view>

    <view class="cal-panel">
      <view class="cal-head">
        <view class="cal-head-copy">
          <text class="cal-year">{{viewYear}}</text>
          <text class="cal-month">{{monthTitle}}</text>
        </view>
        <view class="cal-nav">
          <view class="cal-nav-btn" data-delta="-1" bindtap="onShiftMonth">‹</view>
          <view class="cal-nav-mid" bindtap="onGoToday">{{copy.thisMonth}}</view>
          <view class="cal-nav-btn" data-delta="1" bindtap="onShiftMonth">›</view>
        </view>
      </view>

      <view class="cal-sheet">
        <view class="cal-week">
          <text wx:for="{{weekHeaders}}" wx:key="*this" class="cal-w">{{item}}</text>
        </view>
        <view class="cal-days">
          <view
            wx:for="{{calendarDays}}"
            wx:key="key"
            class="cal-day-cell"
            data-current="{{item.current}}"
            data-date="{{item.dateKey}}"
            bindtap="onSelectDay"
          >
            <view class="cal-day {{item.current ? '' : 'mute'}} {{item.today ? 'today' : ''}} {{item.noteCount > 0 ? 'has' : ''}} {{item.dateKey === selectedDateKey ? 'active' : ''}}">
              <text class="cal-day-n">{{item.n}}</text>
              <view wx:if="{{item.tags.length}}" class="cal-day-tags">
                <view
                  wx:for="{{item.tags}}"
                  wx:for-item="tag"
                  wx:key="key"
                  class="cal-tag"
                  data-type="{{tag.key}}"
                >
                  <view class="cal-tag-dot" />
                  <text class="cal-tag-t">{{tag.label}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="cal-picked {{agendaPulse ? 'pulse' : ''}}">
        <view class="picked-day">
          <text class="picked-n">{{selectedDayNum}}</text>
        </view>
        <view class="picked-copy">
          <text class="picked-title">{{selectedDateLabel}}</text>
          <view class="picked-meta-row">
            <text class="picked-meta">{{noteMetaText}}</text>
            <view wx:if="{{selectedDayTags.length}}" class="picked-tags">
              <view
                wx:for="{{selectedDayTags}}"
                wx:key="key"
                class="picked-tag"
                data-type="{{item.key}}"
              >
                <view class="picked-tag-dot" />
                <text class="picked-tag-t">{{item.label}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="cal-agenda">
        <view class="note-seg">
          <view
            wx:for="{{noteTypes}}"
            wx:key="key"
            class="note-seg-item {{draftType === item.key ? 'active' : ''}}"
            data-type="{{item.key}}"
            bindtap="onDraftType"
          >{{item.label}}</view>
        </view>

        <view wx:if="{{selectedNotes.length}}" class="note-list">
          <view
            wx:for="{{selectedNotes}}"
            wx:key="id"
            class="note-item"
            data-type="{{item.type}}"
          >
            <view class="note-mark" />
            <view class="note-body">
              <view class="note-top">
                <view class="note-tag" data-type="{{item.type}}">
                  <view class="note-tag-dot" />
                  <text class="note-tag-t">{{item.typeLabel}}</text>
                </view>
                <text class="note-time">{{item.createdAt}}</text>
              </view>
              <text class="note-text">{{item.text}}</text>
            </view>
            <text class="note-del" data-id="{{item.id}}" bindtap="onRemoveNote">{{copy.delete}}</text>
          </view>
        </view>
        <view wx:else class="note-empty">
          <text class="empty-text">{{copy.noteEmpty}}</text>
        </view>

        <view class="note-composer">
          <textarea
            class="note-input"
            value="{{draftText}}"
            placeholder="{{draftPlaceholder}}"
            maxlength="120"
            auto-height
            disabled="{{noteSaving}}"
            bindinput="onDraftInput"
          />
          <view class="composer-foot">
            <text class="counter">{{draftText.length}}/120</text>
            <view
              class="btn-primary {{noteSaving || !draftText ? 'disabled' : ''}}"
              bindtap="onAddNote"
            >{{addNoteText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view>
          <text class="sec-title">{{copy.todoTitle}}</text>
          <text class="sec-sub">{{copy.todoSub}}</text>
        </view>
        <text class="chip soft">{{todos.length}}</text>
      </view>
      <view class="todo-list">
        <view wx:for="{{todos}}" wx:key="id" class="todo-row">
          <view class="check" data-level="{{item.level}}" />
          <view class="todo-body">
            <text class="todo-title">{{item.title}}</text>
            <text class="todo-time">{{item.time}}</text>
          </view>
          <view class="todo-go" data-path="{{item.path}}" bindtap="onNav">{{copy.handle}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view>
          <text class="sec-title">{{copy.msgTitle}}</text>
          <text class="sec-sub">{{copy.msgSub}}</text>
        </view>
        <text class="link-btn" data-path="/pages/message/inbox" bindtap="onNav">{{copy.msgAll}}</text>
      </view>
      <view class="msg-list">
        <view
          wx:for="{{messages}}"
          wx:key="id"
          class="msg-row"
          data-path="/pages/message/inbox"
          bindtap="onNav"
        >
          <view class="msg-mark tone-{{item.tone}}">{{item.short}}</view>
          <view class="msg-body">
            <text class="msg-name">{{item.name}}</text>
            <text class="msg-text">{{item.text}}</text>
          </view>
          <text class="msg-time">{{item.time}}</text>
        </view>
        <view wx:if="{{!messages.length}}" class="msg-empty">{{copy.msgEmpty}}</view>
      </view>
    </view>
  </view>
</view>
