<view class="workbench-page">
  <view class="hero-card">
    <view class="hero-kicker">{{brand.workspaceKicker}}</view>
    <view class="hero-title">{{brand.workspaceTitle}}</view>
    <view class="hero-sub">{{brand.workspaceSub}}</view>
    <view class="hero-chips">
      <view class="chip">用户</view>
      <view class="chip">机构</view>
      <view class="chip">角色</view>
      <view class="chip accent">消息 {{unreadCount}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <view class="section-title">系统管理</view>
      <view class="section-note">只读查阅</view>
    </view>
    <view class="grid">
      <view
        class="grid-item"
        wx:for="{{sysMenus}}"
        wx:key="name"
        data-path="{{item.path}}"
        bindtap="onNavigate"
      >
        <view class="grid-icon" style="background: {{item.color}};">{{item.icon}}</view>
        <view class="grid-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <view class="section-title">个人服务</view>
      <view class="section-note">账号相关</view>
    </view>
    <view class="grid">
      <view
        class="grid-item"
        wx:for="{{personalMenus}}"
        wx:key="name"
        data-path="{{item.path}}"
        bindtap="onNavigate"
      >
        <view class="grid-icon" style="background: {{item.color}};">
          {{item.icon}}
          <view wx:if="{{item.badge}}" class="badge">{{item.badge}}</view>
        </view>
        <view class="grid-name">{{item.name}}</view>
      </view>
    </view>
  </view>
</view>
