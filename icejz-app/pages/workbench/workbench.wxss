.workbench-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.1), transparent 36%),
    #f4f7fb;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-card {
  background:
    radial-gradient(circle at 90% 10%, rgba(62, 198, 255, 0.3), transparent 36%),
    linear-gradient(135deg, #121a28 0%, #0c6f9c 100%);
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 36, 0.16);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.55);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 20rpx;
}

.chip.accent {
  background: #00a8e8;
}

.section-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 16rpx 18rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 12rpx 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-note {
  font-size: 20rpx;
  color: #00a8e8;
  background: #e8f7fd;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.grid-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(0, 168, 232, 0.16);
}

.grid-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #374151;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}
