.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.12), transparent 40%),
    #f4f7fb;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 36rpx 30rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(62, 198, 255, 0.34), transparent 38%),
    linear-gradient(135deg, #121a28 0%, #143047 52%, #0c6f9c 100%);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 36, 0.16);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.6;
  max-width: 420rpx;
}

.hero-stat {
  min-width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-stat-num {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-stat-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.panel {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 8rpx 16rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 20rpx 12rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.panel-action {
  color: #00a8e8;
  font-size: 22rpx;
  padding: 10rpx 18rpx;
  background: #e8f7fd;
  border-radius: 999rpx;
}

.empty {
  padding: 72rpx 24rpx;
  text-align: center;
}

.empty-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f7fbfe, #eef6fb);
  color: #00a8e8;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  margin-top: 18rpx;
  color: #475569;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.6;
}

.msg-item {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin: 0 12rpx 12rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f8fbfe, #f3f8fc);
}

.msg-item.is-unread {
  background: linear-gradient(180deg, #eef9fe, #e7f5fc);
  box-shadow: inset 0 0 0 1rpx rgba(0, 168, 232, 0.18);
}

.msg-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #00a8e8;
  flex-shrink: 0;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.msg-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.msg-time {
  color: #94a3b8;
  font-size: 20rpx;
  flex-shrink: 0;
}

.msg-meta {
  margin-top: 8rpx;
  color: #00a8e8;
  font-size: 22rpx;
}

.msg-content {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
