<view class="page">
  <ice-nav-bar title="{{copy.title}}" sub="{{copy.sub}}">
    <view slot="right" class="stat-chip" wx:if="{{unreadCount > 0}}">
      <text class="stat-num">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </ice-nav-bar>

  <view class="panel">
    <view class="panel-head">
      <view class="panel-title">{{copy.list}}</view>
      <view class="panel-action" bindtap="onReadAll">{{copy.readAll}}</view>
    </view>

    <view wx:if="{{loading}}" class="empty">
      <view class="empty-mark">···</view>
      <view class="empty-title">{{copy.syncing}}</view>
    </view>
    <view wx:elif="{{!list.length}}" class="empty">
      <view class="empty-mark">信</view>
      <view class="empty-title">{{copy.empty}}</view>
      <view class="empty-desc">{{copy.emptyHint}}</view>
    </view>

    <view
      wx:for="{{list}}"
      wx:key="id"
      class="msg-item {{item.readStatus === 0 ? 'is-unread' : ''}}"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="msg-dot" wx:if="{{item.readStatus === 0}}"></view>
      <view class="msg-body">
        <view class="msg-top">
          <view class="msg-title">{{item.title}}</view>
          <view class="msg-time">{{item.sendTime || item.createTime}}</view>
        </view>
        <view class="msg-meta">{{item.senderName || copy.system}}</view>
        <view class="msg-content">{{item.content}}</view>
      </view>
    </view>
  </view>
</view>
