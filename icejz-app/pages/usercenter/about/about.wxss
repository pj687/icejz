.about-page {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 32rpx;
  box-sizing: border-box;
}

.about-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(20, 24, 32, 0.06);
}

.about-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.about-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2332;
}

.about-sub {
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  color: #00a8e8;
  font-size: 24rpx;
}

.about-intro {
  line-height: 1.8;
  color: #6b7280;
  font-size: 26rpx;
}
