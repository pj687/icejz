.about-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.1), transparent 36%),
    #f4f7fb;
  padding: 32rpx;
  box-sizing: border-box;
}

.about-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.about-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.about-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2332;
  letter-spacing: 2rpx;
}

.about-sub {
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  color: #00a8e8;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.about-intro {
  line-height: 1.8;
  color: #6b7280;
  font-size: 26rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #f7fbfe, #f2f8fc);
  border: 1rpx solid rgba(0, 168, 232, 0.06);
}
