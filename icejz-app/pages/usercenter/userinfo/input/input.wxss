.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.12), transparent 40%),
    #f3f6fa;
}

.body {
  padding: 8rpx 28rpx 48rpx;
}

.panel {
  margin-top: 0;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.05);
}

.field-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mark-img {
  width: 36rpx;
  height: 36rpx;
}

.mark.dark {
  background: rgba(2, 132, 199, 0.12);
}

.mark.cyan {
  background: rgba(0, 168, 232, 0.12);
}

.mark.sky {
  background: rgba(14, 165, 233, 0.12);
}

.field-meta {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f1724;
}

.tip {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7a8899;
}

.input-shell {
  margin-top: 28rpx;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #f7fafc;
  border: 1rpx solid rgba(232, 238, 245, 0.9);
  display: flex;
  align-items: center;
}

.field-input {
  width: 100%;
  font-size: 30rpx;
  color: #0f1724;
}

.compare {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(0, 168, 232, 0.06);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.compare-item {
  flex: 1;
  min-width: 0;
}

.compare-label {
  display: block;
  font-size: 20rpx;
  color: #7a8899;
}

.compare-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f1724;
  word-break: break-all;
  line-height: 1.5;
}

.compare-value.accent {
  color: #00a8e8;
}

.compare-arrow {
  color: #94a3b8;
  font-size: 28rpx;
  flex-shrink: 0;
}

.save-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow: 0 14rpx 28rpx rgba(0, 168, 232, 0.26);
}

.save-btn::after {
  border: none;
}
