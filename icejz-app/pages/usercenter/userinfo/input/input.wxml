<view class="input-edit">
  <form bindsubmit="onSubmit">
    <t-input wx:if="{{user.realName}}" name="realName" value="{{user.realName}}" label="姓名" placeholder="请输入姓名" borderless clearable />
    <t-input wx:if="{{user.mobile}}" name="mobile" value="{{user.mobile}}" label="手机号" placeholder="请输入手机号" borderless clearable />
    <t-input wx:if="{{user.email}}" name="email" value="{{user.email}}" label="邮箱" placeholder="请输入邮箱" borderless clearable />
    <view class="input-btn">
      <t-button block type="submit">保存</t-button>
    </view>
  </form>
</view>