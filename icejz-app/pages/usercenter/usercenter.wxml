<view class="user-center-card">
  <view class="user-center-card__header">
    <t-avatar image="{{user.avatar || 'https://oss.mlh.jucheng.icu/logo.png'}}" class="user-center-card__header__avatar" />
    <view class="user-center-card__header__meta">
      <view class="user-center-card__header__name">{{user.realName}}</view>
      <view class="user-center-card__header__sub">{{brand.slogan}}</view>
    </view>
  </view>
</view>
<view class="content-wrapper">
  <view class="nav-group-wrapper">
    <view class="nav-group">
      <t-cell-group>
        <t-cell t-class="nav-group__top" title="常用功能" note="查看全部" arrow />
      </t-cell-group>
      <view class="nav-group__content">
        <view class="nav-group__item" wx:for="{{menuData}}" wx:for-item="item" wx:key="index" data-index="{{index}}" bindtap="onClickMenu">
          <view class="nav-group__item__icon">
            <t-badge count="{{item.count}}" color="#FF4646">
              <t-icon name="{{item.icon}}" size="56rpx" color="#00a8e8" />
            </t-badge>
          </view>
          <view class="nav-group__item__title">{{item.title}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="cell-box">
    <t-cell-group>
      <t-cell title="个人信息" arrow url="userinfo/userinfo"></t-cell>
      <t-cell title="修改密码" arrow url="password/password"></t-cell>
      <t-cell title="关于我们" arrow url="about/about"></t-cell>
      <t-cell title="联系作者" note="QQ 960681673" arrow bind:click="openMakePhone"></t-cell>
    </t-cell-group>
  </view>
  <view class="cell-box">
    <t-cell-group>
      <t-cell title="退出登录" bind:click="onLogout">
        <t-icon name="poweroff" size="48rpx" slot="note" />
      </t-cell>
    </t-cell-group>
  </view>
</view>

<t-popup visible="{{showMakePhone}}" placement="bottom" bind:visible-change="closeMakePhone">
  <view class="popup-content">
    <view class="popup-title border-bottom-1px">
      服务时间: 每周一至周五 9:00-12:00 14:00-18:00
    </view>
    <view class="popup-phone border-bottom-1px" bind:tap="onPhoneCall">QQ：960681673（点击复制）</view>
    <view class="popup-phone border-bottom-1px" bind:tap="onPhoneCall">邮箱：960681673@qq.com</view>
    <view class="popup-close" bind:tap="closeMakePhone">取消</view>
  </view>
</t-popup>
