<view class="page">
  <ice-nav-bar title="{{copy.title}}" sub="{{copy.sub}}" />

  <view class="body">
    <view class="tips">
      <text class="tip-chip">{{copy.tipMix}}</text>
      <text class="tip-chip">{{copy.tipDiff}}</text>
    </view>

    <view class="panel">
      <view class="field">
        <text class="label">{{copy.old}}</text>
        <view class="input-shell">
          <input
            password
            value="{{passwordForm.password}}"
            placeholder="{{copy.oldPh}}"
            class="input"
            data-key="password"
            bindinput="onInput"
          />
        </view>
      </view>
      <view class="field">
        <text class="label">{{copy.newPwd}}</text>
        <view class="input-shell">
          <input
            password
            value="{{passwordForm.newPassword}}"
            placeholder="{{copy.newPh}}"
            class="input"
            data-key="newPassword"
            bindinput="onInput"
          />
        </view>
      </view>
      <view class="field last">
        <text class="label">{{copy.confirm}}</text>
        <view class="input-shell">
          <input
            password
            value="{{passwordForm.confirmPassword}}"
            placeholder="{{copy.confirmPh}}"
            class="input"
            data-key="confirmPassword"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <button class="save-btn" loading="{{saving}}" bindtap="onPassword">{{copy.save}}</button>
  </view>
</view>
