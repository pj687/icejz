<view class="password">
  <form bindsubmit="onPassword">
    <t-input label="原密码" type="password" name="password" placeholder="请输入原密码" />
    <t-input label="新密码" type="password" name="newPassword" placeholder="请输入新密码" />
    <t-input label="确认密码" type="password" name="confirmPassword" placeholder="请输入确认密码" />
    <view class="password-btn">
      <t-button block type="submit">保存</t-button>
    </view>
  </form>
</view>