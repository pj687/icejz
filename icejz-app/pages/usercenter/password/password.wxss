.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.12), transparent 40%),
    #f3f6fa;
}

.body {
  padding: 8rpx 28rpx 48rpx;
}

.tips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tip-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 168, 232, 0.1);
  color: #0284c7;
  font-size: 20rpx;
  font-weight: 650;
}

.panel {
  margin-top: 18rpx;
  padding: 12rpx 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.05);
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.field.last {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f1724;
  margin-bottom: 14rpx;
}

.input-shell {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f3f6fa;
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
}

.input {
  width: 100%;
  font-size: 28rpx;
  color: #0f1b2d;
}

.save-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 750;
  color: #fff;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow: 0 14rpx 28rpx rgba(0, 168, 232, 0.26);
}

.save-btn::after {
  border: none;
}
