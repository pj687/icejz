.password {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.08), transparent 36%),
    #f4f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.password form,
.password > form {
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 20rpx 28rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.password-btn {
  margin-top: 40rpx;
}
