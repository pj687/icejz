<view class="page">
  <ice-nav-bar title="{{copy.title}}" sub="{{copy.sub}}" />

  <view class="body">
    <view class="panel">
      <text class="group">{{copy.groupGeneral}}</text>

      <view class="lang-card">
        <view class="lang-copy">
          <text class="lang-title">{{copy.language}}</text>
          <text class="lang-desc">{{copy.languageHint}}</text>
        </view>
        <view class="lang-switch">
          <view
            class="lang-opt {{locale === 'zh-CN' ? 'on' : ''}}"
            data-code="zh-CN"
            bindtap="switchLocale"
          >中</view>
          <view
            class="lang-opt {{locale === 'en-US' ? 'on' : ''}}"
            data-code="en-US"
            bindtap="switchLocale"
          >EN</view>
        </view>
      </view>

      <view class="cell" data-path="/pages/usercenter/about/about" bindtap="go">
        <view class="cell-l">
          <view class="mark">
            <image class="mark-img" src="/images/icons/about.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.about}}</text>
            <text class="note">{{copy.aboutHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="cell" bindtap="replayGuide">
        <view class="cell-l">
          <view class="mark soft">
            <image class="mark-img" src="/images/icons/about.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.replay}}</text>
            <text class="note">{{copy.replayHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="panel">
      <text class="group">{{copy.groupPermission}}</text>

      <view class="cell" bindtap="openSystemSetting">
        <view class="cell-l">
          <view class="mark">
            <image class="mark-img" src="/images/icons/album.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.album}}</text>
            <text class="note">{{copy.albumHint}}</text>
          </view>
        </view>
        <text class="perm {{albumClass}}">{{albumLabel}}</text>
      </view>

      <view class="cell" bindtap="openSystemSetting">
        <view class="cell-l">
          <view class="mark">
            <image class="mark-img" src="/images/icons/camera.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.camera}}</text>
            <text class="note">{{copy.cameraHint}}</text>
          </view>
        </view>
        <text class="perm {{cameraClass}}">{{cameraLabel}}</text>
      </view>

      <view class="cell" bindtap="openSystemSetting">
        <view class="cell-l">
          <view class="mark soft">
            <image class="mark-img" src="/images/icons/settings.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.openSystemSetting}}</text>
            <text class="note">{{copy.openSystemSettingHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="panel">
      <text class="group">{{copy.groupSecurity}}</text>

      <view class="cell" data-path="/pages/usercenter/userinfo/userinfo" bindtap="go">
        <view class="cell-l">
          <view class="mark">
            <image class="mark-img" src="/images/icons/profile.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.profile}}</text>
            <text class="note">{{copy.profileHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="cell" data-path="/pages/usercenter/password/password" bindtap="go">
        <view class="cell-l">
          <view class="mark">
            <image class="mark-img" src="/images/icons/lock.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.password}}</text>
            <text class="note">{{copy.passwordHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="cell" data-path="/pages/usercenter/devices/devices" bindtap="go">
        <view class="cell-l">
          <view class="mark">
            <image class="mark-img" src="/images/icons/device.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.devices}}</text>
            <text class="note">{{copy.devicesHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="panel">
      <text class="group">{{copy.groupStorage}}</text>

      <view class="cell" bindtap="onClearCache">
        <view class="cell-l">
          <view class="mark soft">
            <image class="mark-img" src="/images/icons/settings.svg" mode="aspectFit" />
          </view>
          <view class="copy">
            <text class="title">{{copy.clearCache}}</text>
            <text class="note">{{copy.clearCacheHint}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="ver">
      <text class="ver-lab">{{copy.version}}</text>
      <text class="ver-val">v1.0.3</text>
    </view>
  </view>
</view>
