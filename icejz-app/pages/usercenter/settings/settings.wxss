.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.12), transparent 40%),
    #f3f6fa;
}

.body {
  padding: 8rpx 28rpx 48rpx;
}

.mark-img {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.panel {
  margin-top: 18rpx;
  padding: 18rpx 18rpx 8rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.05);
}

.panel:first-child {
  margin-top: 0;
}

.lang-card {
  margin-bottom: 8rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: #f5f9fc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lang-copy {
  min-width: 0;
}

.lang-title {
  display: block;
  font-size: 28rpx;
  font-weight: 740;
  color: #0f1b2d;
}

.lang-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8492a6;
}

.lang-switch {
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e8eef5;
  flex-shrink: 0;
}

.lang-opt {
  min-width: 56rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 750;
  color: #8492a6;
}

.lang-opt.on {
  background: linear-gradient(145deg, #2bb8ef, #00a8e8);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(0, 168, 232, 0.22);
}

.lang-card + .cell {
  border-top: 1rpx solid #eef2f6;
  margin-top: 4rpx;
}

.group {
  display: block;
  margin: 4rpx 8rpx 14rpx;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 0.08em;
  color: #7aa8c4;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-top: 1rpx solid #eef2f6;
}

.cell:first-of-type {
  border-top: none;
}

.cell-l {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #eaf7fd, #e4f3fb);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mark.soft {
  background: #f3f6fa;
}

.copy {
  min-width: 0;
}

.title {
  display: block;
  font-size: 28rpx;
  font-weight: 680;
  color: #0f1b2d;
}

.note {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8492a6;
}

.arrow {
  font-size: 30rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.perm {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 720;
  line-height: 1.2;
}

.perm.on {
  color: #0a7ea4;
  background: rgba(0, 168, 232, 0.12);
}

.perm.off {
  color: #c2410c;
  background: rgba(234, 88, 12, 0.1);
}

.perm.unknown {
  color: #8492a6;
  background: #f1f5f9;
}

.ver {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.ver-lab,
.ver-val {
  font-size: 22rpx;
  color: #9aa8b6;
}

.ver-val {
  font-weight: 700;
  color: #8492a6;
}
