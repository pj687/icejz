.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(0, 168, 232, 0.12), transparent 40%),
    #f3f6fa;
}

.body {
  padding: 8rpx 28rpx 48rpx;
}

.panel {
  margin-top: 18rpx;
  padding: 26rpx 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 36rpx rgba(15, 35, 55, 0.05);
}

.panel.pref {
  margin-top: 0;
  background:
    radial-gradient(120% 140% at 0% 0%, rgba(0, 168, 232, 0.08), transparent 55%),
    rgba(255, 255, 255, 0.96);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.panel-head.row {
  padding-bottom: 18rpx;
  border-bottom: 1rpx dashed #e8eef5;
}

.kicker {
  display: inline-flex;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #0284c7;
  background: rgba(0, 168, 232, 0.1);
}

.panel-title {
  display: block;
  font-size: 30rpx;
  font-weight: 780;
  color: #0f1b2d;
}

.panel-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8492a6;
}

.eff-chip {
  flex-shrink: 0;
  max-width: 240rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #64748b;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  text-align: center;
  line-height: 1.35;
}

.eff-chip.on {
  color: #0f766e;
  background: rgba(47, 191, 164, 0.12);
  border-color: rgba(47, 191, 164, 0.22);
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.lock-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9a3412;
  background: rgba(251, 146, 60, 0.12);
  border: 1rpx solid rgba(251, 146, 60, 0.28);
}

.mode-card {
  position: relative;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e8eef5;
  background: #fff;
}

.mode-card.locked {
  opacity: 0.45;
}

.mode-card.sys.active {
  border-color: rgba(0, 126, 184, 0.35);
  background: linear-gradient(160deg, rgba(0, 168, 232, 0.08), #fff);
  box-shadow: 0 10rpx 22rpx rgba(0, 168, 232, 0.08);
}

.mode-card.on.active {
  border-color: rgba(15, 118, 110, 0.35);
  background: linear-gradient(160deg, rgba(47, 191, 164, 0.1), #fff);
  box-shadow: 0 10rpx 22rpx rgba(15, 118, 110, 0.08);
}

.mode-card.off.active {
  border-color: rgba(180, 83, 9, 0.3);
  background: linear-gradient(160deg, rgba(251, 191, 36, 0.12), #fff);
  box-shadow: 0 10rpx 22rpx rgba(180, 83, 9, 0.06);
}

.mode-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.mode-badge {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #0284c7;
  background: rgba(0, 168, 232, 0.1);
}

.mode-card.on .mode-badge {
  color: #0f766e;
  background: rgba(47, 191, 164, 0.12);
}

.mode-card.off .mode-badge {
  color: #b45309;
  background: rgba(251, 191, 36, 0.16);
}

.mode-card.active .mode-badge {
  color: #fff;
  background: #00a8e8;
}

.mode-card.on.active .mode-badge {
  background: #0f766e;
}

.mode-card.off.active .mode-badge {
  background: #b45309;
}

.mode-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, #fff 0 35%, transparent 36%), #00a8e8;
}

.mode-card.on .mode-check {
  background: radial-gradient(circle at center, #fff 0 35%, transparent 36%), #0f766e;
}

.mode-card.off .mode-check {
  background: radial-gradient(circle at center, #fff 0 35%, transparent 36%), #b45309;
}

.mode-title {
  display: block;
  font-size: 28rpx;
  font-weight: 740;
  color: #122033;
}

.mode-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #64748b;
}

.mode-note {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 650;
  color: #7aa8c4;
}

.limit-panel {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e8eef5;
  background: #f7fbfe;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.limit-panel.dimmed {
  opacity: 0.55;
}

.limit-copy {
  min-width: 0;
  flex: 1;
}

.limit-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #122033;
}

.limit-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #8492a6;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  color: #0f1b2d;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn.disabled {
  opacity: 0.4;
}

.step-val {
  min-width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 780;
  color: #0f1b2d;
}

.pref-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.save-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 750;
  color: #fff;
  background: linear-gradient(145deg, #00a8e8, #2bb8ef);
  box-shadow: 0 14rpx 28rpx rgba(0, 168, 232, 0.22);
}

.save-btn::after {
  border: none;
}

.reload-btn {
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #f3f6fa;
  color: #3d4b5c;
  font-size: 26rpx;
  font-weight: 650;
}

.refresh {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f6fa;
  color: #0284c7;
  font-size: 22rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 20rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  border-radius: 20rpx;
  background: #f7fbfe;
  border: 1rpx dashed #e8eef5;
}

.empty.soft {
  border-style: solid;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.device-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e8eef5;
  background: #fff;
}

.device-item.current {
  border-color: rgba(0, 168, 232, 0.28);
  background: linear-gradient(135deg, rgba(0, 168, 232, 0.06), #fff);
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 780;
  color: #0284c7;
  background: rgba(0, 168, 232, 0.1);
  flex-shrink: 0;
}

.device-main {
  min-width: 0;
  flex: 1;
}

.device-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.device-name {
  font-size: 28rpx;
  font-weight: 740;
  color: #122033;
}

.badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #0284c7;
  background: rgba(0, 168, 232, 0.12);
}

.device-meta {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.device-ua {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-actions {
  flex-shrink: 0;
  padding-top: 8rpx;
}

.kick-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #c45b6a;
  background: rgba(196, 91, 106, 0.08);
  border: 1rpx solid rgba(196, 91, 106, 0.16);
}

.kick-btn.busy {
  opacity: 0.55;
}

.current-tip {
  font-size: 22rpx;
  font-weight: 650;
  color: #0284c7;
}
