page {
  background-color: #f4f7fb;
}

.user-center-card {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 480rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(62, 198, 255, 0.35), transparent 36%),
    linear-gradient(135deg, #121a28 0%, #143047 55%, #0c6f9c 100%);
  padding: 0 24rpx;
  box-sizing: border-box;
}

.user-center-card__header {
  margin-top: 192rpx;
  margin-bottom: 48rpx;
  height: 96rpx;
  line-height: 48rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  color: #fff;
  position: relative;
}

.user-center-card__header__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
}

.user-center-card__header__name {
  font-size: 36rpx;
  line-height: 48rpx;
  color: #fff;
  font-weight: bold;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.content-wrapper {
  margin-top: 340rpx;
  position: relative;
  padding: 0 30rpx 40rpx;
}

.nav-group-wrapper {
  margin-bottom: 16rpx;
}

.nav-group {
  margin-bottom: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
  overflow: hidden;
}

.nav-group .nav-group__top {
  padding: 24rpx 18rpx 24rpx 32rpx;
}

.nav-group__content {
  overflow: hidden;
  width: 100%;
  min-height: 164rpx;
  display: flex;
  background-color: #fff;
}

.nav-group__item {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 20rpx 0 28rpx;
}

.nav-group__item__icon {
  margin-bottom: 12rpx;
}

.nav-group__item__title {
  font-size: 24rpx;
  color: #374151;
}

.cell-box {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 245, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 36, 0.04);
}

.popup-content {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.popup-title {
  padding: 28rpx 32rpx;
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
}

.popup-phone {
  padding: 32rpx;
  text-align: center;
  font-size: 32rpx;
  color: #00a8e8;
  background: #fff;
}

.popup-phone.online {
  margin: 0;
  border-radius: 0;
  line-height: 1.4;
}

.popup-close {
  margin-top: 16rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 32rpx;
  color: #6b7280;
  background: #fff;
}

.border-bottom-1px {
  border-bottom: 1rpx solid #eef3f8;
}
